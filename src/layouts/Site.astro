---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectModal from "../components/ProjectModal.astro";
import Measurement from "../components/Measurement.astro";
import "../styles/source.css";
import "../styles/site.css";
import "../styles/services.css";
import "../styles/legacy.css";
import "../styles/about.css";
import "../styles/areas.css";
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "@fontsource/open-sans/400.css";
import "@fontsource/cormorant-garamond/700.css";
interface Props {
  title: string;
  bodyClass?: string;
  meta?: Record<string, string>[];
  canonical?: string;
  robots?: string;
  schema?: unknown[];
}
const {
  title,
  bodyClass = "page",
  meta = [],
  canonical,
  robots = "index, follow",
  schema = [],
} = Astro.props;
const site = process.env.SITE_URL || Astro.url.origin;
const canonicalPath = canonical
  ? new URL(canonical).pathname
  : Astro.url.pathname;
const localize = (value: string) =>
  value.replaceAll("https://veritybuildstg.wpenginepowered.com", site);
const staging = process.env.INDEXABLE !== "true";
const assets = await import("../../docs/assets.json");
function metadataValue(value: string) {
  const u = value.startsWith("https://veritybuildstg.wpenginepowered.com")
    ? new URL(value)
    : null;
  if (u?.pathname.startsWith("/wp-content/")) {
    const a = Object.entries(assets.default).find(
      ([, v]) => v.source === u.pathname,
    );
    return a ? new URL(a[0], site).href : "";
  }
  return localize(value);
}
function localizeStructuredData(value: unknown): unknown {
  if (typeof value === "string") return metadataValue(value);
  if (Array.isArray(value)) return value.map(localizeStructuredData);
  if (value !== null && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value).map(([key, item]) => [
        key,
        localizeStructuredData(item),
      ]),
    );
  }
  return value;
}
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Measurement />
    {canonicalPath === "/" && (
      <link
        rel="preload"
        as="image"
        href="/assets/a399ddb102-verity_hero-e1786715846853-1200.webp"
        imagesrcset="/assets/a399ddb102-verity_hero-e1786715846853-720.webp 720w, /assets/a399ddb102-verity_hero-e1786715846853-1200.webp 1200w, /assets/a399ddb102-verity_hero-e1786715846853.webp 1795w"
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    <link rel="canonical" href={new URL(canonicalPath, site).href} />
    <meta
      name="robots"
      content={staging ? "noindex, nofollow" : robots}
    />
    {meta
      .filter((m) => m.name !== "robots")
      .map((m) => (
        <meta {...{ ...m, content: metadataValue(m.content || "") }} />
      ))}
    {schema.map((s) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(localizeStructuredData(s)).replaceAll(
          "<",
          "\\u003c",
        )}
      ></script>
    ))}
  </head>
  <body class={bodyClass}>
    <div id="page" class="site">
      <a class="skip-link screen-reader-text" href="#primary">
        Skip to content
      </a>
      <Header />
      <slot />
      <Footer />
    </div>
    <ProjectModal />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
