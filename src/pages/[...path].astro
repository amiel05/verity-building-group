---
import Site from "../layouts/Site.astro";
import Portfolio from "../components/Portfolio.astro";
import BlogIndex from "../components/BlogIndex.astro";
import ContactForm from "../components/ContactForm.astro";
import { replaceArrowGlyphs } from "../lib/icons";
const pages = import.meta.glob("../content/pages/*.json", {
  eager: true,
  import: "default",
}) as Record<
  string,
  {
    path: string;
    title: string;
    bodyClass: string;
    canonical: string;
    meta: Record<string, string>[];
    schema: unknown[];
    sections: string[];
  }
>;
const path = Astro.url.pathname;
const blogRoutes: Record<
  string,
  { initialTopic?: string; initialLocation?: string; heading?: string }
> = {
  "/insights/": {},
  "/category/field-guide/": {},
  "/category/custom-home-construction/": {
    initialTopic: "Custom Home Construction",
    heading: "Custom Home Construction\nInsights",
  },
  "/category/land-development/": {
    initialTopic: "Land Development",
    heading: "Land Development\nInsights",
  },
  "/category/legacy-projects/": {
    initialTopic: "Legacy Projects",
    heading: "Legacy Projects\nInsights",
  },
  "/category/uncategorized/": {
    initialTopic: "Uncategorized",
    heading: "Uncategorized\nInsights",
  },
  "/tag/charlotte/": {
    initialLocation: "Charlotte",
    heading: "Charlotte\nInsights",
  },
  "/tag/cornelius/": {
    initialLocation: "Cornelius",
    heading: "Cornelius\nInsights",
  },
  "/tag/davidson/": {
    initialLocation: "Davidson",
    heading: "Davidson\nInsights",
  },
  "/tag/huntersville/": {
    initialLocation: "Huntersville",
    heading: "Huntersville\nInsights",
  },
  "/tag/lake-norman/": {
    initialLocation: "Lake Norman",
    heading: "Lake Norman\nInsights",
  },
  "/tag/mooresville/": {
    initialLocation: "Mooresville",
    heading: "Mooresville\nInsights",
  },
};
const blogProps = blogRoutes[path];
const singleHeadingPaths = new Set([
  "/contact/",
  "/case-studies/",
  "/custom-home-budget-planning-where-to-start-in-cornelius/",
  "/what-thoughtful-homebuilding-means-for-charlotte-families/",
  "/before-you-buy-a-lake-norman-homesite-a-builder-s-due-diligence-checklist/",
]);
const primaryServiceDetailPaths = new Set([
  "/legacy-projects/",
  "/land-development-charlotte-nc/",
  "/custom-home-builder-charlotte-nc/",
]);
const homePortfolioCarousel = `
<section class="work-section home-portfolio-section" id="portfolio" aria-labelledby="home-portfolio-title">
  <div class="container">
    <div class="work-section__header">
      <div class="section-heading section-heading--inline animatedParent animateOnce" data-sequence="400">
        <h2 class="animated fadeInLeftShort" data-id="1" id="home-portfolio-title">Our Portfolio</h2>
        <p class="animated fadeInLeftShort" data-id="2">A closer look at the homes, land, and details we build with purpose.</p>
      </div>
    </div>
    <div class="work-gallery animatedParent animateOnce" data-sequence="400">
      <div class="work-gallery__items work-gallery-init animated fadeIn" data-id="1">
        <div class="swiper">
          <div class="swiper-wrapper">
            <div class="swiper-slide"><img alt="Verity custom home portfolio project" decoding="async" height="1000" loading="lazy" src="/assets/018219e5b4-gallery-1.webp" width="1000" /></div>
            <div class="swiper-slide"><img alt="Verity residential construction portfolio project" decoding="async" height="1000" loading="lazy" src="/assets/206eb54091-gallery-2.webp" width="1000" /></div>
            <div class="swiper-slide"><img alt="Verity homebuilding portfolio detail" decoding="async" height="1000" loading="lazy" src="/assets/d422901874-gallery-3.webp" width="1000" /></div>
            <div class="swiper-slide"><img alt="Verity finished home portfolio project" decoding="async" height="1000" loading="lazy" src="/assets/0e9eb6aeba-gallery-4.webp" width="1000" /></div>
            <div class="swiper-slide"><img alt="Verity building portfolio detail" decoding="async" height="1000" loading="lazy" src="/assets/a4b53212c6-gallery-5.webp" width="1000" /></div>
          </div>
          <button class="swiper-button-prev" type="button" aria-label="Previous portfolio image"></button>
          <button class="swiper-button-next" type="button" aria-label="Next portfolio image"></button>
        </div>
      </div>
    </div>
  </div>
</section>`;
const normalizePageHtml = (html: string) => {
  let normalized = replaceArrowGlyphs(html);
  if (path === "/" || path === "/home-2/") {
    normalized = normalized.replace(
      /(<\/section>\s*)(<section class="contact-section")/,
      `$1${homePortfolioCarousel}\n$2`,
    );
  }
  if (path !== "/" && path !== "/home-2/") {
    normalized = normalized
      .replace(/<h1 class="([^"]*)"/g, '<h1 class="$1 page-title"')
      .replace(/<h1(?![^>]*class=)/g, '<h1 class="page-title"');
  }
  normalized = normalized
    .replace(
      /class="content-block-search__label"/g,
      'class="content-block-search__label form-label"',
    )
    .replace(
      /class="content-block-search__input"/g,
      'class="content-block-search__input form-control"',
    )
    .replace(
      /class="content-block-search__button content-element-button"/g,
      'class="content-block-search__button content-element-button vbg-btn"',
    );
  if (primaryServiceDetailPaths.has(path)) {
    normalized = normalized.replace(
      /class="services-link"/,
      'class="vbg-btn vbg-btn--arrow"',
    );
  }
  if (path === "/land-development-charlotte-nc/") {
    normalized = normalized.replace(
      'class="services-wrap legacy-focus land-settings"',
      'class="services-wrap legacy-focus legacy-focus--aligned land-settings"',
    );
  }
  if (!singleHeadingPaths.has(path)) return normalized;
  normalized = normalized.replace(
    /<h1 class="[^"]*entry-title[^"]*">[\s\S]*?<\/h1>/,
    "",
  );
  return path === "/case-studies/"
    ? normalized.replace(
        /<h2 class="vbg-display-title">([\s\S]*?)<\/h2>/,
        '<h1 class="vbg-display-title">$1</h1>',
      )
    : normalized;
};
const requestedPage = Object.values(pages).find((p) => p.path === path);
const homepage = Object.values(pages).find((p) => p.path === "/");
/* `/home-2/` is retained for compatibility, but it no longer maintains a
   second visual implementation of the homepage. */
const page =
  path === "/home-2/" && requestedPage && homepage
    ? {
        ...requestedPage,
        bodyClass: homepage.bodyClass,
        sections: homepage.sections,
      }
    : requestedPage;
if (!page) Astro.response.status = 404;
---

<Site
  title={page?.title || "Page not found | Verity Building Group"}
  bodyClass={page?.bodyClass}
  canonical={page?.canonical}
  meta={page?.meta}
  schema={page?.schema}
>
  {page && path === "/portfolio/" ? (
    <Portfolio />
  ) : page && blogProps ? (
    <BlogIndex {...blogProps} />
  ) : page ? (
    page.sections.map((html, index) => (
      <>
        <Fragment set:html={normalizePageHtml(html)} />
        {index < page.sections.length - 1 && (
          <ContactForm id={`page-inquiry-${index}`} />
        )}
      </>
    ))
  ) : (
    <main id="primary" class="basic-content-row">
      <div class="container">
        <h1>Page not found</h1>
        <p>The page you’re looking for could not be found.</p>
        <a href="/">Return home</a>
      </div>
    </main>
  )}
</Site>
