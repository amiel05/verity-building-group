---
import { posts, topics, locations, filterPosts } from "../lib/blog";
import ActionArrow from "./ActionArrow.astro";
import ProjectCta from "./ProjectCta.astro";
import "../styles/blog.css";
interface Props {
  initialTopic?: string;
  initialLocation?: string;
  heading?: string;
}
const {
  initialTopic = "",
  initialLocation = "",
  heading = "Practical perspective.\nThoughtful building.",
} = Astro.props;
const params = Astro.url.searchParams;
const filters = new URLSearchParams(params);
if (initialTopic) filters.set("topic", initialTopic);
if (initialLocation) filters.set("location", initialLocation);
const results = filterPosts(filters);
const [featured, ...remaining] = results;
const hasQueryFilters = ["q", "topic", "location"].some((key) =>
  params.get(key),
);
const filtered = Boolean(initialTopic || initialLocation || hasQueryFilters);
const date = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "America/New_York",
  }).format(new Date(value));
---

<main id="primary" class="blog-page body-regular">
  <header class="blog-heading blog-wrap">
    <p class="blog-kicker eyebrow">The Verity Field Guide</p>
    <h1 class="page-title">
      {heading.split("\n").map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </h1>
    <p class="body-lead">
      Ideas and guidance for planning a custom home, evaluating land, and making
      confident building decisions in the Charlotte region.
    </p>
  </header>
  <div class="blog-layout blog-wrap">
    <aside class="blog-sidebar" aria-labelledby="blog-filters-title">
      <h2 id="blog-filters-title">Find your perspective</h2>
      <form
        method="get"
        action={Astro.url.pathname + "#articles"}
        role="search"
      >
        <label for="blog-query">Search articles</label>
        <input
          id="blog-query"
          type="search"
          name="q"
          value={params.get("q") || ""}
          placeholder="Budget, homesite, planning…"
        />
        <label for="blog-topic">Topic</label>
        <select id="blog-topic" name="topic">
          <option value="">All topics</option>
          {topics.map((topic) => (
            <option value={topic} selected={filters.get("topic") === topic}>
              {topic} ({posts.filter((p) => p.topic === topic).length})
            </option>
          ))}
        </select>
        <label for="blog-location">Location</label>
        <select id="blog-location" name="location">
          <option value="">All locations</option>
          {locations.map((location) => (
            <option
              value={location}
              selected={filters.get("location") === location}
            >
              {location}
            </option>
          ))}
        </select>
        <button type="submit">
          Explore articles <ActionArrow />
        </button>
        {hasQueryFilters && (
          <a class="blog-reset" href={Astro.url.pathname + "#articles"}>
            Clear all filters
          </a>
        )}
      </form>
      <div class="blog-sidebar-note">
        <p class="blog-kicker">From idea to possibility</p>
        <p>Have a property or a project in mind?</p>
        <a href="/contact/">
          Start a conversation <ActionArrow />
        </a>
      </div>
    </aside>
    <section
      id="articles"
      class="blog-results"
      aria-label="Field Guide articles"
    >
      <div class="blog-results-heading">
        <p>
          {filtered
            ? `${results.length} ${results.length === 1 ? "article" : "articles"} found`
            : "Latest from the Field Guide"}
        </p>
        <span>Newest first</span>
      </div>
      {featured ? (
        <>
          <article class="blog-featured">
            <a
              class="clickable-image clickable-image__media"
              href={featured.path}
              aria-label={`Read ${featured.title}`}
            >
              <img
                src={featured.image}
                alt={featured.alt}
                width="1536"
                height="1024"
                fetchpriority="high"
              />
            </a>
            <div class="blog-featured-copy">
              <p class="blog-kicker">
                {filtered ? "Latest match" : "Newest article"} ·{" "}
                {featured.topic}
              </p>
              <h2>
                <a href={featured.path}>{featured.title}</a>
              </h2>
              <p class="blog-date">
                <time datetime={featured.date}>{date(featured.date)}</time> ·{" "}
                {featured.location}
              </p>
              <p>{featured.excerpt}</p>
              <a class="blog-read" href={featured.path}>
                Read the article <ActionArrow />
              </a>
            </div>
          </article>
          {remaining.length > 0 && (
            <div class="blog-older">
              <h2>More perspectives</h2>
              {remaining.map((post) => (
                <article class="blog-row">
                  <a
                    class="clickable-image clickable-image__media"
                    href={post.path}
                    aria-label={`Read ${post.title}`}
                  >
                    <img
                      src={post.image}
                      alt={post.alt}
                      width="600"
                      height="400"
                      loading="lazy"
                    />
                  </a>
                  <div>
                    <p class="blog-kicker">
                      {post.topic} · {post.location}
                    </p>
                    <h3>
                      <a href={post.path}>{post.title}</a>
                    </h3>
                    <p class="blog-date">
                      <time datetime={post.date}>{date(post.date)}</time>
                    </p>
                    <p>{post.excerpt}</p>
                    <a class="blog-read" href={post.path}>
                      Read the article <ActionArrow />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="blog-empty">
          <h2>No articles match those filters.</h2>
          <p>Try a different topic, location, or search term.</p>
          <a class="blog-read" href={Astro.url.pathname + "#articles"}>
            View all articles <ActionArrow />
          </a>
        </div>
      )}
    </section>
  </div>
  <ProjectCta id="field-guide-cta-title" />
</main>
