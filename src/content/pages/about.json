  "sections": [
    "<main id=\"primary\" class=\"services-page about-page\">\n  <header class=\"services-intro\">\n    <div class=\"services-wrap\">\n      <p class=\"services-eyebrow\">About Verity Building Group</p>\n      <div class=\"services-intro__grid\">\n        <h1>Thoughtful building.<br />Clear guidance.<br />Enduring value.</h1>\n        <div class=\"services-intro__copy\">\n          <p>\n            Verity Building Group helps clients move complex building ideas\n            forward with disciplined planning, careful coordination, and respect\n            for the places people call home, work, and community.\n          </p>\n          <a class=\"services-button\" href=\"/contact/\"\n            >Start Your Project <span aria-hidden=\"true\">↗</span></a\n          >\n        </div>\n      </div>\n      <nav class=\"services-jump\" aria-label=\"Explore Verity\">\n        <a href=\"#our-approach\"\n          >Our approach <span aria-hidden=\"true\">↓</span></a\n        ><a href=\"#our-team\"\n          >Our team <span aria-hidden=\"true\">↓</span></a\n        ><a href=\"#areas-we-serve\"\n          >Areas we serve <span aria-hidden=\"true\">↓</span></a\n        >\n      </nav>\n    </div>\n  </header>\n  <section\n    id=\"our-approach\"\n    class=\"services-wrap legacy-focus legacy-focus--aligned\"\n    aria-labelledby=\"approach-title\"\n  >\n    <div class=\"legacy-focus__intro\">\n      <p class=\"services-eyebrow\">The whole project, considered</p>\n      <h2 id=\"approach-title\">Confidence begins<br />with understanding.</h2>\n    </div>\n    <div class=\"legacy-focus__list\">\n      <article>\n        <span class=\"services-number\" aria-hidden=\"true\">01</span>\n        <h3>A relationship-led approach</h3>\n        <div class=\"about-copy\">\n          <p>\n            Every successful project begins with listening. We work to\n            understand the site, the people involved, the desired experience,\n            and the decisions that will shape the work before construction\n            begins.\n          </p>\n          <p>\n            From early feasibility through completion, our role is to make the\n            process understandable, keep priorities visible, and coordinate the\n            details required to build with confidence.\n          </p>\n        </div>\n      </article>\n      <article>\n        <span class=\"services-number\" aria-hidden=\"true\">02</span>\n        <h3>Built around the whole project</h3>\n        <div class=\"about-copy\">\n          <p>\n            Land, design, permitting, budgets, schedules, consultants, and\n            construction are connected. Treating them as one coordinated effort\n            helps uncover constraints earlier and supports better decisions\n            throughout the project.\n          </p>\n          <p>\n            Our work spans custom homes, land development, residential\n            renovation, and community-focused Legacy Projects.\n          </p>\n        </div>\n      </article>\n    </div>\n  </section>\n  <section class=\"services-planning\" aria-labelledby=\"work-title\">\n    <div class=\"services-wrap\">\n      <div class=\"legacy-approach__heading\">\n        <p class=\"services-eyebrow\">How we work</p>\n        <h2 id=\"work-title\">Listen. Plan. Build.</h2>\n      </div>\n      <ol class=\"services-process about-process\">\n        <li>\n          <span class=\"services-number\" aria-hidden=\"true\">01</span>\n          <h3>Listen first</h3>\n          <p>\n            We begin with goals, property context, intended use, timing, and the\n            questions that matter most to the client.\n          </p>\n        </li>\n        <li>\n          <span class=\"services-number\" aria-hidden=\"true\">02</span>\n          <h3>Plan with clarity</h3>\n          <p>\n            We identify the information, decisions, and professional\n            coordination needed to define a responsible path forward.\n          </p>\n        </li>\n        <li>\n          <span class=\"services-number\" aria-hidden=\"true\">03</span>\n          <h3>Build for the long term</h3>\n          <p>\n            We focus on durable value, thoughtful execution, and spaces designed\n            to serve the people who will use them.\n          </p>\n        </li>\n      </ol>\n    </div>\n  </section>\n  <section\n    id=\"our-team\"\n    class=\"services-wrap legacy-focus\"\n    aria-labelledby=\"vbg-team-heading\"\n  >\n    <div class=\"legacy-focus__intro\">\n      <div>\n        <p class=\"services-eyebrow\">The people behind the process</p>\n        <h2 id=\"vbg-team-heading\">Leading Your Crew</h2>\n      </div>\n      <p>\n        Your project will be guided by people focused on clear communication,\n        coordinated decisions, and thoughtful execution. Individual profiles are\n        coming soon.\n      </p>\n    </div>\n    <div class=\"about-team\">\n      <figure class=\"vbg-team-card vbg-team-card--placeholder\">\n        <svg\n          aria-label=\"Male team member coming soon\"\n          role=\"img\"\n          viewbox=\"0 0 900 1200\"\n        >\n          <rect fill=\"#e6e6e6\" height=\"1200\" width=\"900\"></rect>\n          <rect\n            fill=\"#f7f7f7\"\n            height=\"1152\"\n            rx=\"28\"\n            stroke=\"#202020\"\n            stroke-width=\"8\"\n            width=\"852\"\n            x=\"24\"\n            y=\"24\"\n          ></rect>\n          <circle cx=\"450\" cy=\"405\" fill=\"#d1d1d1\" r=\"190\"></circle>\n          <path\n            d=\"M285 397c0-133 67-220 165-220s165 87 165 220v52c0 107-72 204-165 204s-165-97-165-204z\"\n            fill=\"#9a9a9a\"\n          ></path>\n          <path\n            d=\"M300 378c20-147 91-214 177-204 77 8 128 78 136 190-47-48-92-74-138-79-64-7-119 25-175 93z\"\n            fill=\"#303030\"\n          ></path>\n          <path\n            d=\"M171 1009c18-202 125-323 279-323s261 121 279 323z\"\n            fill=\"#303030\"\n      