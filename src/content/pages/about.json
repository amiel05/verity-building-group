   fill=\"#202020\"\n            font-family=\"Arial,Helvetica,sans-serif\"\n            font-size=\"42\"\n            font-weight=\"700\"\n            letter-spacing=\"7\"\n            text-anchor=\"middle\"\n            x=\"450\"\n            y=\"1084\"\n          >\n            COMING SOON\n          </text>\n        </svg>\n      </figure>\n      <figure class=\"vbg-team-card vbg-team-card--placeholder\">\n        <svg\n          aria-label=\"Male team member coming soon\"\n          role=\"img\"\n          viewbox=\"0 0 900 1200\"\n        >\n          <rect fill=\"#e6e6e6\" height=\"1200\" width=\"900\"></rect>\n          <rect\n            fill=\"#f7f7f7\"\n            height=\"1152\"\n            rx=\"28\"\n            stroke=\"#202020\"\n            stroke-width=\"8\"\n            width=\"852\"\n            x=\"24\"\n            y=\"24\"\n          ></rect>\n          <circle cx=\"450\" cy=\"405\" fill=\"#d1d1d1\" r=\"190\"></circle>\n          <path\n            d=\"M285 397c0-133 67-220 165-220s165 87 165 220v52c0 107-72 204-165 204s-165-97-165-204z\"\n            fill=\"#9a9a9a\"\n          ></path>\n          <path\n            d=\"M300 378c20-147 91-214 177-204 77 8 128 78 136 190-47-48-92-74-138-79-64-7-119 25-175 93z\"\n            fill=\"#303030\"\n          ></path>\n          <path\n            d=\"M171 1009c18-202 125-323 279-323s261 121 279 323z\"\n            fill=\"#303030\"\n          ></path>\n          <rect\n            fill=\"#fff\"\n            height=\"96\"\n            rx=\"48\"\n            stroke=\"#303030\"\n            stroke-width=\"5\"\n            width=\"648\"\n            x=\"126\"\n            y=\"1020\"\n          ></rect>\n          <text\n            fill=\"#202020\"\n            font-family=\"Arial,Helvetica,sans-serif\"\n            font-size=\"42\"\n            font-weight=\"700\"\n            letter-spacing=\"7\"\n            text-anchor=\"middle\"\n            x=\"450\"\n            y=\"1084\"\n          >\n            COMING SOON\n          </text>\n        </svg>\n      </figure>\n    </div>\n  </section>\n  <section\n    id=\"areas-we-serve\"\n    class=\"about-areas\"\n    aria-labelledby=\"areas-title\"\n  >\n    <div class=\"services-wrap\">\n      <div class=\"services-section-heading about-areas__heading\">\n        <div>\n          <p class=\"services-eyebrow\">Areas we serve</p>\n          <h2 id=\"areas-title\">\n            Charlotte, Lake Norman,<br />and nearby communities.\n          </h2>\n        </div>\n        <p class=\"about-areas__intro\">\n          Verity Building Group serves clients across the Charlotte and Lake\n          Norman region, subject to project fit, schedule, and availability.\n          Local knowledge matters—from site conditions and neighborhood\n          character to jurisdictional review and the professionals needed to\n          move a project forward.\n        </p>\n      </div>\n      <div class=\"about-area-grid\">\n        <a\n          class=\"about-area-card\"\n          href=\"/custom-home-builder-in-charlotte-nc/\"\n          aria-labelledby=\"area-1-title\"\n          ><h3 id=\"area-1-title\">Charlotte</h3>\n          <p>\n            Custom residential construction and renovation opportunities\n            throughout Charlotte and its surrounding neighborhoods.\n          </p>\n          <span class=\"about-area-card__action\"\n            >Explore Charlotte <span aria-hidden=\"true\">→</span></span\n          ></a\n        >\n        <a\n          class=\"about-area-card\"\n          href=\"/lake-norman-custom-home-builder/\"\n          aria-labelledby=\"area-2-title\"\n          ><h3 id=\"area-2-title\">Lake Norman</h3>\n          <p>\n            Homesites, custom residences, and land-focused projects shaped by\n            waterfront conditions, access, views, and long-term use.\n          </p>\n          <span class=\"about-area-card__action\"\n            >Explore Lake Norman <span aria-hidden=\"true\">→</span></span\n          ></a\n        >\n        <a\n          class=\"about-area-card\"\n          href=\"/north-mecklenburg-iredell-builder/\"\n          aria-labelledby=\"area-3-title\"\n          ><h3 id=\"area-3-title\">North Mecklenburg & Iredell</h3>\n          <p>\n            Cornelius, Davidson, Huntersville, Mooresville, and nearby\n            communities where thoughtful planning can align property potential\n            with project goals.\n          </p>\n          <span class=\"about-area-card__action\"\n            >Explore North Mecklenburg & Iredell\n            <span aria-hidden=\"true\">→</span></span\n          ></a\n        >\n      </div>\n    </div>\n  </section>\n  <section\n    class=\"services-wrap about-services\"\n    aria-labelledby=\"services-title\"\n  >\n    <h2 id=\"services-title\">Explore our services</h2>\n    <div class=\"service-grid\">\n      <article class=\"service-card\">\n        <div class=\"service-card__image\">\n          <a\n            class=\"service-card__image-link\"\n            href=\"/custom-home-builder-charlotte-nc/\"\n            aria-label=\"Explore Custom Home Construction\"\n          >\n            <img\n              src=\"/assets/205cb24db5-verity_new-home.webp\"\n              alt=\"Custom luxury home construction in Charlotte and Lake Norman\"\n              width=\"1000\"\n              height=\"1000\"\n              decoding=\"async\"\n            />\n          </a>\n        </div>\n        <div class=\"service-card__body\">\n          <h3>\n            <a href=\"/custom-home-builder-charlotte-nc/\"\n              >Custom Home Construction</a\n            >\n          </h3>\n          <a class=\"cta-link\" href=\"/custom-home-builder-charlotte-nc/\"\n            >Learn More\n            <span aria-hidden=\"true\"\n              ><span aria-hidden=\"true\" class=\"interface-icon\">→</span></span\n            ></a\n          >\n        </div>\n      </article>\n      <article class=\"service-card\">\n        <div class=\"service-card__image\">\n          <a\n            class=\"service-card__image-link\"\n            href=\"/land-development-charlotte-nc/\"\n            aria-label=\"Explore Land Development\"\n          >\n            <img\n              src=\"/assets/61d87d5380-verity_land-development.webp\"\n              alt=\"Land development planning for a Charlotte-area homesite\"\n              width=\"1000\"\n              height=\"1000\"\n              decoding=\"async\"\n            />\n          </a>\n        </div>\n        <div class=\"service-card__body\">\n          <h3><a href=\"/land-development-charlotte-nc/\">Land Development</a></h3>\n          <a class=\"cta-link\" href=\"/land-development-charlotte-nc/\"\n            >Learn More\n            <span aria-hidden=\"true\"\n              ><span aria-hidden=\"true\" class=\"interface-icon\">→</span></span\n            ></a\n          >\n        </div>\n      </article>\n      <article class=\"service-card\">\n        <div class=\"service-card__image\">\n          <a\n            class=\"service-card__image-link\"\n            href=\"/legacy-projects/\"\n            aria-label=\"Explore Legacy Projects\"\n          >\n            <img\n              src=\"/assets/f032cd6272-verity-legacy-neighborhood-home-v2.webp\"\n              alt=\"Modest one-story neighborhood home representing a future Verity Legacy Project\"\n              width=\"1672\"\n              height=\"941\"\n              decoding=\"async\"\n            />\n          </a>\n        </div>\n        <div class=\"service-card__body\">\n          <h3><a href=\"/legacy-projects/\">Legacy Projects</a></h3>\n          <a class=\"cta-link\" href=\"/legacy-projects/\"\n            >Learn More\n            <span aria-hidden=\"true\"\n              ><span aria-hidden=\"true\" class=\"interface-icon\">→</span></span\n            ></a\n          >\n        </div>\n      </article>\n    </div>\n  </section>\n  <section class=\"services-closing\" aria-labelledby=\"about-closing-title\">\n    <div class=\"services-wrap services-closing__grid\">\n      <div>\n        <p class=\"services-eyebrow\">Begin with Verity</p>\n        <h2 id=\"about-closing-title\">\n          Exploring a project<br />in the region?\n        </h2>\n        <p>\n          Start with the property location, project type, intended use, and\n          current stage. We will review the basics and help identify the most\n          useful next conversation.\n        </p>\n      </div>\n      <a class=\"services-button\" href=\"/contact/\"\n        >Start Your Project <span aria-hidden=\"true\">↗</span></a\n      >\n    </div>\n  </section>\n</main>\n"
